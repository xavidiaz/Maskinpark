@using Maskinpark.Client.Models
<div class="card">
  <div class="card-header fw-semibold">List of Machines</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Id</th>
          <th>Status</th>
          <th>Last Data</th>
          <th>Last Updated</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var m in Machines)
        {
          <tr>
            <td>@m.Name</td>
            <td><small class="text-muted">@m.Id</small></td>
            <td>@(m.IsOnline ? "Online" : "Offline")</td>
            <td>@m.LastData</td>
            <td>@m.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code
{
  [Parameter]
  public List<Machine> Machines { get; set; } = [];
}
