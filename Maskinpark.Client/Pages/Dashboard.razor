@page "/dashboard"
@using Maskinpark.Client.Models

<PageTitle>Dashboard</PageTitle>

<h1 class="mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Total Machines</div>
        <div class="fs-3 fw-semibold">@Total</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Machines Online</div>
        <div class="fs-3 fw-semibold text-success">@OnlineCount</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Machines Offline</div>
        <div class="fs-3 fw-semibold text-danger">@OfflineCount</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Last Updated</div>
        <div class="fs-5 fw-semibold">@(LastUpdatedName ?? "–")</div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">List of Machines</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Id</th>
          <th>Status</th>
          <th>Last Data</th>
          <th>Last Updated</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var m in machines)
        {
          <tr>
            <td>@m.Name</td>
            <td><small class="text-muted">@m.Id</small></td>
            <td>@(m.IsOnline ? "Online" : "Offline")</td>
            <td>@m.LastData</td>
            <td>@m.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  private List<Machine> machines =
  [
    new Machine { Id = Guid.NewGuid(), Name = "Mixer 01", IsOnline = true, LastData = "Temp: 75°C", LastUpdated =
DateTime.UtcNow.AddMinutes(-5) },
    new Machine { Id = Guid.NewGuid(), Name = "Mixer 02", IsOnline = true, LastData = "RPM: 1500", LastUpdated =
DateTime.UtcNow.AddMinutes(-2) },
    new Machine { Id = Guid.NewGuid(), Name = "Crusher 01", IsOnline = true, LastData = "Amps: 34", LastUpdated =
DateTime.UtcNow.AddMinutes(-20) },
    new Machine { Id = Guid.NewGuid(), Name = "Pump 01", IsOnline = false, LastData = "Pressure: 120 bar", LastUpdated =
DateTime.UtcNow.AddHours(-3) },
    new Machine { Id = Guid.NewGuid(), Name = "Borrmaskin", IsOnline = false, LastData = "Vibration: 0.6g", LastUpdated =
DateTime.UtcNow.AddHours(-1) },
  ];

  private int Total => machines.Count;
  private int OnlineCount => machines.Count(m => m.IsOnline);
  private int OfflineCount => machines.Count(m => !m.IsOnline);
  private string? LastUpdatedName => machines.MaxBy(m => m.LastUpdated)?.Name;
}
