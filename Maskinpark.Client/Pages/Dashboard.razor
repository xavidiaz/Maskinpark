@page "/dashboard"
@using Maskinpark.Client.Components
@using Maskinpark.Client.Models

<PageTitle>Dashboard</PageTitle>

<h1 class="mb-4">Dashboard</h1>

<EditForm Model="@newMachine" OnValidSubmit="@Create" class="mb-4">
  <DataAnnotationsValidator />
  <div class="input-group">
    <InputText @bind-Value="newMachine.Name" class="form-control" placeholder="Machine name" />
    <button type="submit" class="btn btn-primary">Add Machine</button>
  </div>
</EditForm>

<MachineStats Machines="machines" />

<MachineList Machines="machines" OnToggleStatus="ToggleStatus" OnSendData="SendData" OnDelete="Delete" />

@code {
  private List<Machine> machines =
  [
    new Machine { Id = Guid.NewGuid(), Name = "Mixer 01", IsOnline = true, LastData = "Temp: 75°C", LastUpdated =
DateTime.UtcNow.AddMinutes(-5) },
    new Machine { Id = Guid.NewGuid(), Name = "Mixer 02", IsOnline = true, LastData = "RPM: 1500", LastUpdated =
DateTime.UtcNow.AddMinutes(-2) },
    new Machine { Id = Guid.NewGuid(), Name = "Crusher 01", IsOnline = true, LastData = "Amps: 34", LastUpdated =
DateTime.UtcNow.AddMinutes(-20) },
    new Machine { Id = Guid.NewGuid(), Name = "Pump 01", IsOnline = false, LastData = "Pressure: 120 bar", LastUpdated =
DateTime.UtcNow.AddHours(-3) },
    new Machine { Id = Guid.NewGuid(), Name = "Borrmaskin", IsOnline = false, LastData = "Vibration: 0.6g", LastUpdated =
DateTime.UtcNow.AddHours(-1) },
  ];

  private Machine newMachine = new() { Name = "" };

  private void Create()
  {
    newMachine.Id = Guid.NewGuid();
    newMachine.LastUpdated = DateTime.UtcNow;
    machines.Add(newMachine);
    // rensa fältet
    newMachine = new() { Name = "" };
  }

  private void Delete(Machine machine)
  {
    if (!machines.Remove(machine))
    {
      // TODO(Fas 8): Visa feedback om maskinen inte finns i listan
    }
  }

  private void ToggleStatus(Machine machine)
  {
    machine.IsOnline = !machine.IsOnline;
    machine.LastUpdated = DateTime.UtcNow;
  }

  private void SendData(Machine machine)
  {
    if (!machine.IsOnline) return;

    machine.LastData = sampleData[Random.Shared.Next(sampleData.Length)];
    machine.LastUpdated = DateTime.UtcNow;
  }

  private static readonly string[] sampleData =
  [
      "Temp: 72°C", "RPM: 1480", "Amps: 31", "Pressure: 118 bar", "Vibration: 0.4g"
  ];

}

